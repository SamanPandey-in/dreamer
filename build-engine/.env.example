# General-purpose Redis (route cache, metrics, pub/sub, log Streams) —
# same instance log-relay.ts reads from, NOT the redis-builder instance
# (that one is BullMQ-queue-only; see api-server's REDIS_BUILDER_URL
# comment). Matches EcsDeploymentEngine's own launchBuildTask, which
# forwards api-server's REDIS_URL (not REDIS_BUILDER_URL) to the build
# task the same way.
REDIS_URL=redis://redis:6379

# ── S3-compatible storage (MinIO) ────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_MINIO_ROOT_USER
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
S3_ENDPOINT_URL=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=dreamer-outputs
BASE_DOMAIN=deploy.yourdomain.com

# DEPLOYMENT_MODE=docker switches the DYNAMIC branch from Kaniko+ECR to a
# plain local `docker build` — see script.js / docker-build.js.
DEPLOYMENT_MODE=docker

# Injected by api-server's DockerDeploymentEngine as `docker run -e ...`
# for a real deploy — only set these by hand when testing this container
# standalone, outside the platform.
DEPLOYMENT_ID=
PROJECT_SLUG=
GIT_REPOSITORY_URL=
BRANCH=main

# Only present for a private-repo deployment. Never set this by hand
# against your own real GitHub token unless you're prepared to revoke it
# afterwards — use a disposable fine-grained PAT scoped to one test repo.
GIT_ACCESS_TOKEN=

DEPLOYMENT_TYPE=
FRAMEWORK=
