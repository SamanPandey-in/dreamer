# Rendered from this template by nginx's own official image at container
# start (any file under /etc/nginx/templates/*.template gets envsubst'd
# into /etc/nginx/conf.d/*.conf automatically — no custom entrypoint
# script needed). ${DOMAIN} is the only variable actually substituted;
# every other "$..." below is a normal nginx runtime variable and is left
# alone, since it was never set as a real container environment variable.
#
# Three logical destinations, one certificate (issued by
# scripts/lib/issue-certificate.sh covering both ${DOMAIN} and
# *.${DOMAIN} as SANs in a single cert):
#   ${DOMAIN}, www.${DOMAIN}   -> frontend            (the dashboard)
#   api.${DOMAIN}               -> api-server          (REST + Socket.IO)
#   *.${DOMAIN}  (everything else) -> reverse-proxy    (deployed apps)

# Plain HTTP -> HTTPS redirect for every hostname this domain covers.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} *.${DOMAIN};
    return 301 https://$host$request_uri;
}

# --- Dashboard (the Dreamer frontend itself) -----------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- api-server: REST API + Socket.IO realtime gateway -------------------
# api-server now serves BOTH REST and Socket.IO from the SAME listener on
# port 8000 (see apps/api-server/src/index.ts and
# src/realtime/socket.server.ts) — Socket.IO intercepts requests under its
# own /socket.io/ path before they reach Express's router. That means one
# location block for everything, proxying to one upstream port; no more
# splitting by path to two different ports the way this file used to.
# NEXT_PUBLIC_SOCKET_URL and NEXT_PUBLIC_API_BASE_URL can be — and now
# should be — the exact same URL (https://api.${DOMAIN}).
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://api-server:8000;
        proxy_http_version 1.1;
        # Required for Socket.IO's WebSocket upgrade under /socket.io/ —
        # harmless no-ops for ordinary REST requests, so one location block
        # can serve both instead of splitting by path.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Wildcard: every deployed app (project-slug.${DOMAIN}) ---------------
# Matches anything that isn't ${DOMAIN}/www.${DOMAIN}/api.${DOMAIN} above —
# nginx always prefers the most specific server_name match regardless of
# the order server blocks appear in the file, so this catch-all is safe
# to have last. Hands off entirely to reverse-proxy, which already does
# its own STATIC (S3) vs DYNAMIC (Lambda Function URL) routing per
# request — this block's only job is getting the request onto the
# private compose network and preserving the original Host header so
# reverse-proxy knows which subdomain was actually requested.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name *.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://reverse-proxy:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
