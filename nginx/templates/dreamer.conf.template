# Rendered from this template by nginx's own official image at container
# start (any file under /etc/nginx/templates/*.template gets envsubst'd
# into /etc/nginx/conf.d/*.conf automatically — no custom entrypoint
# script needed). ${DOMAIN} and ${ENABLE_PUSH_DEPLOY} are the variables
# actually substituted; every other "$..." below is a normal nginx runtime
# variable and is left alone.
#
# local-engine network exposure — see
# docs/architecture/local-engine-auth-and-networking.md Decision 4. This
# file is deliberately NOT symmetric with the cloud engine's version: the
# dashboard (frontend + api-server's REST/dashboard API) has NO server
# block here at all — no ${DOMAIN}, no www.${DOMAIN}, no api.${DOMAIN}.
# It's reachable only via docker-compose.yml's 127.0.0.1-bound ports
# (SSH tunnel from the operator's own machine), never through this public
# listener. The only things this file ever routes publicly are:
#
#   *.${DOMAIN}         -> reverse-proxy   (deployed apps + custom domains)
#   hooks.${DOMAIN}      -> api-server, ONLY /api/webhooks/github
#                            (opt-in: ENABLE_PUSH_DEPLOY=true)
#
# nginx always prefers the most specific server_name match regardless of
# the order server blocks appear in the file, so hooks.${DOMAIN} (exact)
# safely takes priority over the *.${DOMAIN} (wildcard) block below it,
# and nothing else on api-server is ever reachable through this listener —
# not projects, not env vars, not the git PAT, not auth — regardless of
# ENABLE_PUSH_DEPLOY.

# Plain HTTP -> HTTPS redirect for every hostname this domain covers.
server {
    listen 80;
    listen [::]:80;
    server_name *.${DOMAIN};
    return 301 https://$host$request_uri;
}

# --- Wildcard: every deployed app (project-slug.${DOMAIN}) + custom domains ---
# Matches anything under *.${DOMAIN} — hands off entirely to reverse-proxy,
# which already does its own STATIC (MinIO) vs DYNAMIC (container) routing
# per request, and its own custom-domain lookup. This block's only job is
# getting the request onto the private compose network and preserving the
# original Host header so reverse-proxy knows which subdomain/domain was
# actually requested.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name *.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://reverse-proxy:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# --- Optional: GitHub push-to-deploy webhook receiver -----------------------
# ENABLE_PUSH_DEPLOY must be "true" for this block to do anything real.
# When it's "false" (the default), every request here hits the bare 444
# below instead of ever reaching api-server — nginx's own "close the
# connection, send nothing back" pseudo-status — so hooks.${DOMAIN}
# answers for literally nothing on a fresh install.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name hooks.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # ONLY this exact path is ever proxied — everything else on
    # hooks.${DOMAIN} (including api-server's other routes, if someone
    # tried to guess a path) hits the bare 444 below instead.
    location = /api/webhooks/github {
        # envsubst substitutes this to the literal text "true"/"false" at
        # container start — the plain string compare below is a normal
        # nginx runtime check against that substituted value, not a map:
        # map's source argument must itself be an nginx variable, which a
        # build-time-substituted literal isn't.
        set $push_deploy_enabled "${ENABLE_PUSH_DEPLOY}";
        if ($push_deploy_enabled != "true") {
            return 444;
        }
        proxy_pass http://api-server:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 444;
    }
}
