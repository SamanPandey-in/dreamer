# Rendered by nginx's official image at container start: any file under
# /etc/nginx/templates/*.template gets envsubst'd into /etc/nginx/conf.d/.
#
# Public exposure — this file routes ONLY:
#   *.${DOMAIN}         -> reverse-proxy   (deployed apps + custom domains)
#   hooks.${DOMAIN}     -> api-server, ONLY /api/webhooks/github
#                          (opt-in: ENABLE_PUSH_DEPLOY=true)
#
# The dashboard has NO server block here at all — it's reachable only via
# docker-compose.yml's 127.0.0.1-bound ports over an SSH tunnel, never
# through this public listener.
#
# nginx prefers the most specific server_name regardless of block order,
# so hooks.${DOMAIN} (exact) safely wins over the wildcard below.

# Plain HTTP -> HTTPS redirect for every hostname this domain covers.
server {
    listen 80;
    listen [::]:80;
    server_name *.${DOMAIN};
    return 301 https://$host$request_uri;
}

# --- Wildcard: every deployed app (project-slug.${DOMAIN}) + custom domains ---
# Hands off entirely to reverse-proxy, which does its own STATIC vs DYNAMIC
# routing per request plus its own custom-domain lookup. Preserving Host is
# what lets reverse-proxy know which subdomain/domain was requested.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name *.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://reverse-proxy:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# --- Optional: GitHub push-to-deploy webhook receiver -----------------------
# When ENABLE_PUSH_DEPLOY != "true" (the default), every request here hits
# the bare 444 — close the connection, send nothing back — so hooks.${DOMAIN}
# answers for literally nothing on a fresh install.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name hooks.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # ONLY this exact path is ever proxied — everything else hits 444.
    # ${ENABLE_PUSH_DEPLOY} is envsubst'd to a literal at container start,
    # so a plain string compare here (not a map, whose source must be an
    # nginx runtime variable).
    location = /api/webhooks/github {
        set $push_deploy_enabled "${ENABLE_PUSH_DEPLOY}";
        if ($push_deploy_enabled != "true") {
            return 444;
        }
        proxy_pass http://api-server:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 444;
    }
}
