# Read by docker-compose.yml's own ${VARIABLE} interpolation (Postgres
# startup creds, nginx's DOMAIN, MinIO creds, frontend build args) — NOT
# read by application code directly. Matches the repo's existing
# .env.deploy convention (see scripts/lib/generate-env.sh) with MinIO
# added.
#
# Copy to .env.deploy and fill in. Generate secrets with:
#   openssl rand -hex 32

DOMAIN=deploy.yourdomain.com

POSTGRES_USER=dreamer
POSTGRES_PASSWORD=

MINIO_ROOT_USER=dreamer
MINIO_ROOT_PASSWORD=

S3_BUCKET=dreamer-outputs

NEXT_PUBLIC_API_BASE_URL=https://api.deploy.yourdomain.com
NEXT_PUBLIC_SOCKET_URL=https://api.deploy.yourdomain.com
NEXT_PUBLIC_SITE_URL=https://deploy.yourdomain.com

BUILD_WORKER_CONCURRENCY=5
