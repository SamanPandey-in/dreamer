REDIS_URL=redis://localhost:6379

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=dreamer-outputs
BASE_DOMAIN=singularitydev.xyz

# Injected by api-server's EcsDeploymentEngine (src/deployments/deployment-engine.ts)
# as ECS task container overrides for a real run — only set these by hand
# when testing the build container standalone, outside ECS.
DEPLOYMENT_ID=
PROJECT_SLUG=
GIT_REPOSITORY_URL=
BRANCH=main

# Only present for a private-repo deployment — see §3.7 on the backend side.
# Never set this by hand against your own real GitHub token for local
# testing unless you're prepared to revoke it afterwards; use a disposable
# fine-grained PAT scoped to one test repo instead.
GIT_ACCESS_TOKEN=

# NEW — see script.js. DEPLOYMENT_TYPE=DYNAMIC switches this container from
# the STATIC (S3 upload) pipeline to the DYNAMIC (Kaniko -> ECR) one.
# Injected by deployment-engine.ts, same as everything else in this file —
# only set these by hand for standalone testing.
DEPLOYMENT_TYPE=
FRAMEWORK=
# Required only when DEPLOYMENT_TYPE=DYNAMIC — the shared ECR repo Kaniko
# pushes every dynamic app's image to, e.g.
# 123456789012.dkr.ecr.ap-south-1.amazonaws.com/dreamer-dynamic-apps
ECR_REPOSITORY_URI=