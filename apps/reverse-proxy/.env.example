BASE_DOMAIN=singularitydev.xyz
BASE_PATH=
# NEW — required now. This service used to have zero DB/Redis dependency
# (it blindly built an S3 path from the hostname); it now looks up the
# actual active deployment per request — see deployment-lookup.js.
# Same Postgres instance api-server uses.
DATABASE_URL=postgres://user:password@host:port/defaultdb?sslmode=require&sslcert=ca.pem?pgbouncer=true
# Same Redis instance build-engine/api-server use — used here only as a
# 30s cache in front of the Postgres lookup above.
REDIS_URL=redis://localhost:6379
