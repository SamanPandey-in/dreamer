# Reference only — `npx dreamer-local up` generates .env.local for you
# with real random secrets. This file documents what ends up in it.
#
# DOMAIN is `localtest.me` by default: a public DNS name whose own A
# record AND every subdomain (*.localtest.me) already resolve to
# 127.0.0.1. That gives you the same host-based routing production uses
# (http://<slug>.localtest.me:8080) with no /etc/hosts or DNS setup.
# Override it if you'd rather point it at a real domain you control.

DOMAIN=localtest.me

POSTGRES_USER=dreamer
POSTGRES_PASSWORD=

MINIO_ROOT_USER=dreamer
MINIO_ROOT_PASSWORD=

S3_BUCKET=dreamer-outputs

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

BUILD_WORKER_CONCURRENCY=5

# Host ports — change any of these if they collide with something else
# already running on your machine.
FRONTEND_PORT=3000
API_PORT=8000
REVERSE_PROXY_PORT=8080
