# Manual-setup template. If you used ./install.sh, this file was already
# generated for you (with real secrets) at api-server/.env — you don't
# need this one. This file exists for people setting up by hand; see the
# top-level README's "Manual setup" section for how each block is used.

REDIS_URL=redis://redis:6379
REDIS_BUILDER_URL=redis://redis-builder:6379
DATABASE_URL=postgresql://dreamer:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/dreamer

# ── Local build/run engine ───────────────────────────────────────────────
# Image tag `docker build -t dreamer-build-engine:local ./build-engine`
# produces — DockerDeploymentEngine's launchBuildTask runs this on-demand
# per build.
DOCKER_BUILD_ENGINE_IMAGE=dreamer-build-engine:local
# Must match docker-compose.yml's networks.default.name.
DOCKER_NETWORK=dreamer-local

# ── S3-compatible storage (MinIO) ────────────────────────────────────────
# These are your MinIO credentials, not real AWS ones — @aws-sdk/client-s3
# is just the client library, MinIO speaks the same protocol.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_MINIO_ROOT_USER
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
S3_ENDPOINT_URL=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=dreamer-outputs

# Server
NODE_ENV=production
PORT=8000
# The dashboard is loopback-only by design — see
# docs/architecture/local-engine-auth-and-networking.md Decision 4. This
# stays localhost even in production; it's what CORS/cookie logic checks
# to know the dashboard isn't cross-site from api-server.
FRONTEND_URL=http://localhost:3000
# COOKIE_DOMAIN=   # leave unset for the default loopback setup above — see env.ts's comment if you later expose the dashboard on a real hostname yourself
# CORS_EXTRA_ORIGINS=
# CORS_ORIGIN_REGEX=

# Auth: JWT — generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Auth: encryption for the git Personal Access Token at rest — must be
# exactly 64 hex chars. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Git access — see docs/architecture/local-engine-auth-and-networking.md
# Decision 2. No GitHub App to register: set your Personal Access Token
# from Settings after first login instead (Settings > Git). Nothing to put
# here for it — it's stored encrypted in Postgres, not in this file.

# ── Push-to-deploy webhook (optional) — see Decision 3 & 4. Leave both of
# these unset/false for a fresh install: manual "Redeploy" from the
# dashboard always works regardless. Only fill these in if you want a
# `git push` to trigger a deploy automatically.
# GITHUB_WEBHOOK_SECRET=            # generate with: openssl rand -hex 32 — paste the SAME value into each repo's GitHub webhook settings
# ENABLE_PUSH_DEPLOY=false          # set true (and set docker-compose.yml's matching env) to expose hooks.${DOMAIN}/api/webhooks/github publicly
# API_PUBLIC_URL=https://hooks.REPLACE_WITH_YOUR_DOMAIN   # only used to build the URL you paste into GitHub's webhook settings

BASE_DOMAIN=REPLACE_WITH_YOUR_WILDCARD_DOMAIN   # e.g. samanp.xyz — see docs/architecture/local-engine-auth-and-networking.md's samanp.xyz walkthrough

# Optional: automatic TLS for custom domains users add to their own
# projects, via Render's Custom Domains API. Unrelated to this stack's
# own TLS (that's install.sh + certbot). Leave blank — custom domains
# still work over plain HTTP without this, TLS is just left manual.
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
