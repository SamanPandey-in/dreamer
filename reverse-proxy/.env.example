BASE_DOMAIN=deploy.yourdomain.com

# ── STATIC routing (replaces the S3 REST/website endpoint) ──────────────
# index.js does `proxy.web(req, res, { target: \`${BASE_PATH}/${route.slug}\` })`
# unchanged from the cloud version — http-proxy appends the request's own
# path on top, exactly the way it did against S3. This is the ONLY line
# that needs to change for STATIC apps to work locally: point it at
# MinIO's path-style endpoint (host:port/bucket/__outputs), matching the
# same __outputs/{slug}/... key layout build-engine's script.js has
# always uploaded to (see its runStaticBuild). The bucket is anonymous-
# download (minio-init in docker-compose.yml), same effective posture as
# the S3 bucket's public-read policy in the cloud version.
BASE_PATH=http://minio:9000/dreamer-outputs/__outputs

# ── DYNAMIC routing — NO env var, NO code change ─────────────────────────
# index.js already proxies DYNAMIC requests straight to
# route.appUrl (deployment-lookup.js's DB read), with
# changeOrigin: true. DockerDeploymentEngine already writes
# that column as http://dreamer-app-<slug>:3000 — container-to-container
# DNS on the `dreamer-local` network this service is also on. Nothing
# to configure here.

DATABASE_URL=postgresql://dreamer:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/dreamer
REDIS_URL=redis://redis:6379
